package oxidcord:plugin@1.1.0;

interface types {
	type snowflake = u64;

	record user {
		id: snowflake,
		username: string,
		display-name: string,
		avatar: option<string>,
		bot: bool,
	}

	record message-ref {
		id: snowflake,
		channel-id: snowflake,
		guild-id: option<snowflake>,
	}

	record message-view {
		id: snowflake,
		channel-id: snowflake,
		guild-id: option<snowflake>,
		author: user,
		content: string,
		timestamp-ms: s64,
		edited: bool,
		reply-to: option<snowflake>,
		%flags: u64,
	}

	record outgoing-message {
		channel-id: snowflake,
		content: string,
		reply-to: option<snowflake>,
	}

	record md-tree {
		nodes: list<md-node>,
		roots: list<u32>,
	}

	record md-code-block {
		lang: option<string>,
		code: string,
	}

	record md-heading {
		level: u8,
		children: list<u32>,
	}

	record md-list {
		ordered: bool,
		start: u32,
		items: list<list<u32>>,
	}

	record md-emoji {
		name: string,
		id: u64,
		animated: bool,
	}

	record md-timestamp {
		unix: s64,
		style: string,
	}

	record md-command {
		name: string,
		id: u64,
	}

	record md-link {
		url: string,
		text: option<list<u32>>,
		suppress-embed: bool,
	}

	variant md-node {
		text(string),
		bold(list<u32>),
		italic(list<u32>),
		underline(list<u32>),
		strike(list<u32>),
		spoiler(list<u32>),
		code(string),
		code-block(md-code-block),
		quote(list<u32>),
		heading(md-heading),
		subtext(list<u32>),
		%list(md-list),
		user-mention(u64),
		role-mention(u64),
		channel-mention(u64),
		everyone,
		here,
		custom-emoji(md-emoji),
		timestamp(md-timestamp),
		command-mention(md-command),
		guild-nav(string),
		link(md-link),
		line-break,
	}

	record ui-tree {
		nodes: list<ui-node>,
		roots: list<u32>,
	}

	record ui-box {
		id: option<string>,
		gap: u8,
		padding: u8,
		children: list<u32>,
		align: string,
	}

	record text-style {
		bold: bool,
		muted: bool,
		size: u8,
		color: option<string>,
	}

	record ui-text {
		value: string,
		style: text-style,
	}

	record ui-button {
		id: string,
		label: string,
		%variant: string,
		icon: option<string>,
	}

	record ui-input {
		id: string,
		placeholder: string,
		value: string,
	}

	record ui-toggle {
		id: string,
		label: string,
		on: bool,
	}

	record ui-image {
		url: string,
		width: u32,
		height: u32,
	}

	record ui-badge {
		label: string,
		color: option<string>,
	}

	record ui-link {
		label: string,
		url: string,
	}

	variant ui-node {
		column(ui-box),
		row(ui-box),
		text(ui-text),
		button(ui-button),
		input(ui-input),
		toggle(ui-toggle),
		image(ui-image),
		badge(ui-badge),
		divider,
		icon(string),
		progress(f32),
		link(ui-link),
	}

	enum permission {
		context-basic,
		context-timeline,
		context-directory,
		context-members,
		context-voice,
		context-private,
		message-render,
		message-send,
		message-filter,
		user-display,
		actions-send,
		actions-react,
		actions-navigate,
		actions-clipboard,
		actions-notify,
		actions-open-url,
		storage,
		net-fetch,
		ui-slots,
	}

	variant host-error {
		denied(permission),
		rate-limited,
		invalid(string),
		timeout,
		unavailable,
	}

	record fetch-request {
		method: string,
		url: string,
		headers: list<tuple<string, string>>,
		body: option<list<u8>>,
	}

	record fetch-response {
		status: u16,
		headers: list<tuple<string, string>>,
		body: list<u8>,
	}

	record reaction-event {
		message: message-ref,
		user-id: snowflake,
		emoji: string,
	}

	record typing-event {
		channel-id: snowflake,
		user-id: snowflake,
	}

	record channel-switch {
		guild-id: option<snowflake>,
		channel-id: snowflake,
	}

	record setting-change {
		key: string,
		value: string,
	}

	record guild-summary {
		id: snowflake,
		name: string,
		icon: option<string>,
		owner: bool,
		member-count: option<u32>,
	}

	record channel-summary {
		id: snowflake,
		guild-id: option<snowflake>,
		name: string,
		kind: u32,
		parent-id: option<snowflake>,
		position: u32,
	}

	record member-summary {
		user-id: snowflake,
		display-name: string,
		roles: list<snowflake>,
		status: string,
	}

	record voice-info {
		guild-id: option<snowflake>,
		channel-id: snowflake,
		self-mute: bool,
		self-deaf: bool,
		participants: list<snowflake>,
		speaking: list<snowflake>,
		e2ee: bool,
	}

	variant event {
		message-created(message-view),
		message-updated(message-view),
		message-deleted(message-ref),
		reaction-added(reaction-event),
		typing(typing-event),
		channel-switched(channel-switch),
		setting-changed(setting-change),
		connection(string),
		voice-changed(voice-info),
	}

	variant send-decision {
		pass,
		replace(outgoing-message),
		cancel(string),
	}

	record display-override {
		name: option<string>,
		color: option<string>,
		badge: option<string>,
	}
}

interface host {
	use types.{snowflake, user, message-ref, message-view, outgoing-message, ui-tree, host-error, fetch-request, fetch-response, guild-summary, channel-summary, member-summary, voice-info};

	log: func(level: u8, msg: string);
	storage-get: func(key: string) -> result<option<list<u8>>, host-error>;
	storage-set: func(key: string, value: list<u8>) -> result<_, host-error>;
	storage-delete: func(key: string) -> result<_, host-error>;
	storage-list: func() -> result<list<string>, host-error>;
	fetch: func(req: fetch-request) -> result<fetch-response, host-error>;
	send-message: func(msg: outgoing-message) -> result<snowflake, host-error>;
	add-reaction: func(m: message-ref, emoji: string) -> result<_, host-error>;
	open-channel: func(guild-id: option<snowflake>, channel-id: snowflake) -> result<_, host-error>;
	clipboard-write: func(text: string) -> result<_, host-error>;
	notify: func(title: string, body: string) -> result<_, host-error>;
	open-url: func(url: string) -> result<_, host-error>;
	current-user: func() -> result<user, host-error>;
	current-channel: func() -> result<option<tuple<option<snowflake>, snowflake>>, host-error>;
	channel-messages: func(channel-id: snowflake, limit: u32) -> result<list<message-view>, host-error>;
	display-name: func(guild-id: option<snowflake>, user-id: snowflake) -> result<string, host-error>;
	list-guilds: func() -> result<list<guild-summary>, host-error>;
	list-channels: func(guild-id: option<snowflake>) -> result<list<channel-summary>, host-error>;
	list-members: func(guild-id: snowflake, limit: u32) -> result<list<member-summary>, host-error>;
	voice-state: func() -> result<option<voice-info>, host-error>;
	now-ms: func() -> s64;
	register-slot: func(slot: string, node: ui-tree) -> result<_, host-error>;
	register-command: func(name: string, description: string) -> result<_, host-error>;
}

interface guest {
	use types.{snowflake, user, message-view, outgoing-message, md-tree, ui-tree, event, send-decision, display-override};

	init: func() -> result<_, string>;
	on-event: func(event: event);
	render-message: func(msg: message-view, ast: md-tree) -> option<md-tree>;
	before-send: func(msg: outgoing-message) -> send-decision;
	filter-message: func(msg: message-view) -> bool;
	display-user: func(guild-id: option<snowflake>, user: user) -> option<display-override>;
	on-ui-action: func(id: string, payload: string) -> ui-tree;
	on-command: func(name: string, args: string, channel-id: snowflake) -> result<_, string>;
	settings-schema: func() -> string;
}

interface model {
	use types.{snowflake, message-view, md-node};

	enum tone {
		normal,
		muted,
		brand,
		success,
		warning,
		danger,
	}

	enum space {
		none,
		xs,
		sm,
		md,
		lg,
		xl,
	}

	enum radius {
		none,
		sm,
		md,
		lg,
		full,
	}

	enum text-size {
		tiny,
		xs,
		sm,
		md,
		lg,
		xl,
	}

	enum weight {
		normal,
		medium,
		semibold,
		bold,
	}

	enum align {
		start,
		center,
		end,
		stretch,
	}

	enum justify {
		start,
		center,
		end,
		between,
	}

	enum axis {
		row,
		column,
	}

	enum button-variant {
		solid,
		outline,
		ghost,
		link,
	}

	variant length {
		auto,
		fill,
		px(u32),
	}

	variant color {
		token(string),
		rgba(u32),
	}

	record style {
		width: length,
		height: length,
		padding: space,
		gap: space,
		align: align,
		justify: justify,
		background: option<color>,
		border: option<color>,
		radius: radius,
		tooltip: option<string>,
		disabled: bool,
	}

	record emoji-ref {
		id: option<snowflake>,
		name: string,
		animated: bool,
	}

	variant image-source {
		url(string),
		emoji(emoji-ref),
		avatar(snowflake),
	}

	record stack-node {
		axis: axis,
		wrap: bool,
		children: list<u32>,
	}

	record text-node {
		value: string,
		size: text-size,
		weight: weight,
		tone: tone,
		color: option<color>,
		mono: bool,
		italic: bool,
	}

	record image-node {
		source: image-source,
		width: u32,
		height: u32,
		alt: string,
	}

	record icon-node {
		name: string,
		tone: tone,
		size: u32,
	}

	record avatar-node {
		user-id: snowflake,
		size: u32,
	}

	record emoji-node {
		emoji: emoji-ref,
		size: u32,
	}

	record button-node {
		label: string,
		icon: option<string>,
		tone: tone,
		%variant: button-variant,
		submit: bool,
	}

	record icon-button-node {
		icon: string,
		tone: tone,
	}

	record link-node {
		label: string,
		url: string,
	}

	record input-node {
		value: string,
		placeholder: string,
	}

	record select-option {
		value: string,
		label: string,
	}

	record select-node {
		options: list<select-option>,
		selected: option<string>,
		placeholder: string,
	}

	record check-node {
		label: string,
		checked: bool,
	}

	record slider-node {
		min: f32,
		max: f32,
		step: f32,
		value: f32,
	}

	record badge-node {
		label: string,
		tone: tone,
	}

	record tabs-node {
		labels: list<string>,
		selected: u32,
		children: list<u32>,
	}

	record section-node {
		title: string,
		collapsed: bool,
		children: list<u32>,
	}

	record embed-card {
		title: option<string>,
		description: option<string>,
		url: option<string>,
		accent: option<color>,
		image: option<string>,
		footer: option<string>,
	}

	record timestamp-node {
		unix-ms: s64,
		style: string,
	}

	variant node-kind {
		stack(stack-node),
		scroll(list<u32>),
		spacer,
		divider,
		text(text-node),
		markdown(string),
		image(image-node),
		icon(icon-node),
		avatar(avatar-node),
		emoji(emoji-node),
		button(button-node),
		icon-button(icon-button-node),
		link(link-node),
		input(input-node),
		textarea(input-node),
		select(select-node),
		toggle(check-node),
		checkbox(check-node),
		slider(slider-node),
		progress(f32),
		badge(badge-node),
		tabs(tabs-node),
		section(section-node),
		popover(list<u32>),
		form(list<u32>),
		embed(embed-card),
		user-chip(snowflake),
		channel-chip(snowflake),
		timestamp(timestamp-node),
	}

	record view-node {
		key: option<string>,
		style: option<style>,
		kind: node-kind,
	}

	record view-tree {
		nodes: list<view-node>,
		roots: list<u32>,
	}

	record mount-options {
		title: string,
		icon: option<string>,
		order: s32,
	}

	record ui-context {
		guild-id: option<snowflake>,
		channel-id: option<snowflake>,
		message-id: option<snowflake>,
		user-id: option<snowflake>,
		url: option<string>,
	}

	variant view-event-kind {
		click,
		change(string),
		submit(list<tuple<string, string>>),
		toggle(bool),
		select(string),
		tab(u32),
	}

	record view-event {
		point: string,
		mount: string,
		node: string,
		kind: view-event-kind,
		context: ui-context,
	}

	record view-reply {
		replace: option<view-tree>,
		close-overlay: bool,
		toast: option<string>,
	}

	flags menu-when {
		in-guild,
		in-dm,
		own-message,
		others-message,
		has-content,
		has-attachments,
		self-user,
		other-user,
	}

	record menu-item {
		key: string,
		label: string,
		icon: option<string>,
		tone: tone,
		when: menu-when,
		parent: option<string>,
	}

	record inline-image {
		url: string,
		alt: string,
		width: u32,
		height: u32,
	}

	record styled-span {
		children: list<u32>,
		color: option<color>,
		background: option<color>,
		mono: bool,
	}

	variant rich-node {
		md(md-node),
		inline-image(inline-image),
		styled(styled-span),
	}

	record rich-tree {
		nodes: list<rich-node>,
		roots: list<u32>,
	}

	record attachment-info {
		id: snowflake,
		filename: string,
		content-type: option<string>,
		size: u64,
		url: string,
		width: option<u32>,
		height: option<u32>,
	}

	record embed-info {
		kind: string,
		title: option<string>,
		description: option<string>,
		url: option<string>,
		color: option<u32>,
		provider: option<string>,
		image: option<string>,
		thumbnail: option<string>,
	}

	record sticker-info {
		id: snowflake,
		name: string,
		format: u8,
		guild-id: option<snowflake>,
	}

	record reaction-info {
		emoji: emoji-ref,
		count: u32,
		me: bool,
	}

	variant lifecycle {
		live,
		edited(list<string>),
		deleted(s64),
	}

	record message-full {
		view: message-view,
		attachments: list<attachment-info>,
		embeds: list<embed-info>,
		stickers: list<sticker-info>,
		reactions: list<reaction-info>,
		mentions: list<snowflake>,
		mine: bool,
		lifecycle: lifecycle,
	}

	variant visibility {
		shown,
		hidden(string),
		collapsed(string),
	}

	record annotation {
		text: string,
		icon: option<string>,
		tone: tone,
	}

	record decoration {
		accent: option<color>,
		background: option<color>,
		faded: bool,
		strike: bool,
	}

	variant embed-action {
		keep,
		hide,
		replace(embed-card),
	}

	record message-patch {
		content: option<rich-tree>,
		visibility: visibility,
		annotations: list<annotation>,
		decoration: option<decoration>,
		embeds: list<embed-action>,
		extra-embeds: list<embed-card>,
		hidden-attachments: list<snowflake>,
		accessory: option<view-tree>,
		retain: bool,
	}

	record emoji-info {
		emoji: emoji-ref,
		guild-id: option<snowflake>,
		usable: bool,
		available: bool,
	}

	variant pick-verdict {
		default,
		insert(string),
		block(string),
	}
}

interface ui {
	use types.{host-error};
	use model.{view-tree, mount-options, menu-item};

	mount: func(point: string, key: string, tree: view-tree, options: mount-options) -> result<_, host-error>;
	update: func(point: string, key: string, tree: view-tree) -> result<_, host-error>;
	unmount: func(point: string, key: string) -> result<_, host-error>;
	provide: func(point: string, options: mount-options) -> result<_, host-error>;
	invalidate: func(point: string) -> result<_, host-error>;
	set-menu-items: func(menu: string, items: list<menu-item>) -> result<_, host-error>;
	toast: func(tree: view-tree, ttl-ms: u32) -> result<_, host-error>;
	open-modal: func(title: string, tree: view-tree) -> result<_, host-error>;
}

interface client {
	use types.{snowflake, host-error, outgoing-message};
	use model.{emoji-ref, emoji-info, sticker-info, message-full};

	set-timer: func(delay-ms: u32, repeat-ms: u32, tag: string) -> result<u64, host-error>;
	clear-timer: func(id: u64);
	list-emojis: func(channel-id: option<snowflake>) -> result<list<emoji-info>, host-error>;
	emoji-url: func(emoji: emoji-ref, size: u32) -> option<string>;
	list-stickers: func(guild-id: option<snowflake>) -> result<list<sticker-info>, host-error>;
	sticker-url: func(sticker: sticker-info, size: u32) -> string;
	composer-insert: func(text: string) -> result<_, host-error>;
	get-message: func(channel-id: snowflake, message-id: snowflake) -> result<option<message-full>, host-error>;
	channel-messages-full: func(channel-id: snowflake, limit: u32) -> result<list<message-full>, host-error>;
	send-as-user: func(msg: outgoing-message) -> result<_, host-error>;
}

interface hooks {
	use types.{snowflake};
	use model.{view-tree, ui-context, view-event, view-reply, message-full, rich-tree, message-patch, emoji-ref, pick-verdict};

	render-view: func(point: string, context: ui-context) -> option<view-tree>;
	on-view-event: func(event: view-event) -> view-reply;
	on-menu-item: func(menu: string, key: string, context: ui-context);
	intercept-message: func(msg: message-full, content: rich-tree) -> message-patch;
	on-timer: func(id: u64, tag: string);
	on-emoji-pick: func(emoji: emoji-ref, channel-id: snowflake) -> pick-verdict;
}

world plugin {
	import host;
	export guest;
}

world plugin-ext {
	import host;
	import ui;
	import client;
	export guest;
	export hooks;
}
